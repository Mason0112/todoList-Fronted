# 第一階段：建構前端應用程式
FROM node:20-alpine AS build

# 設定工作目錄
WORKDIR /app

# 將 package.json 和 package-lock.json 複製到容器中
COPY package*.json ./

# 安裝所有依賴
RUN npm install

# 複製所有前端程式碼
COPY . .

# 運行建構命令，例如 `npm run build`
# 請根據你的前端框架 (React, Vue, Angular) 修改此命令
RUN npm run build

# 第二階段：使用 Nginx 提供靜態檔案
FROM nginx:stable-alpine

# 將 Nginx 的預設設定檔刪除
RUN rm /etc/nginx/conf.d/default.conf

# 從第一階段複製建構好的靜態檔案
COPY --from=build /app/dist /usr/share/nginx/html

# 將自定義的 nginx 設定檔複製到容器中
COPY ./nginx.conf /etc/nginx/conf.d/custom.conf

# 暴露 80 埠
EXPOSE 80

# 啟動 Nginx 伺服器
CMD ["nginx", "-g", "daemon off;"]